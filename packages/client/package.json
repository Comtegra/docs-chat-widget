{
  "name": "@comtegra/docs-chat-client",
  "version": "0.1.0",
  "description": "Streaming client and shared SSE contract for the docs-chat assistant API (framework-agnostic)",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Comtegra/docs-chat-widget.git",
    "directory": "packages/client"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "src",
    "schemas",
    "dist",
    "types",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-iife.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "prepublishOnly": "npm run build && npm run build:types",
    "test": "npm run build && node --test \"tests/**/*.test.mjs\""
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "types": "./types/index.d.mts"
}
